{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tooling/check-*.ts"],
      "project": ["scripts/**/*.ts", "tooling/**/*.{ts,js}", "!tooling/oxlint-rules/fixtures/**"],
      "ignoreDependencies": ["jscpd"]
    },
    "packages/engine": {
      "entry": [
        "scripts/*.ts",
        "src/index.ts",
        "src/*.worker.ts",
        "src/*.worklet.ts",
        "bench/*.worker.ts",
        "test/support/page.ts",
        "test/support/ring-producer.ts",
        "test/support/pcm-producer.ts",
        "test/*.unit.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "bench/**/*.ts"],
      "ignoreBinaries": ["ffmpeg", "ffprobe", "taskpolicy"]
    },
    "packages/ffmpeg": {
      "entry": [
        "scripts/*.ts",
        "bench/variants.ts",
        "bench/*worker.js",
        "bench/adapters/*.js",
        "test/*.worker.js"
      ],
      "project": [
        "scripts/**/*.ts",
        "bench/**/*.{ts,js}",
        "test/**/*.{ts,js}",
        "!test/fixtures/**"
      ],
      "paths": {
        "/test/*": ["./test/*"]
      },
      "ignoreBinaries": ["ffmpeg", "ffprobe"],
      "ignoreDependencies": ["libav.js", "mediabunny"],
      "ignoreUnresolved": ["^/dist/"]
    },
    "packages/sync": {
      "entry": ["test/*.unit.ts"]
    },
    "packages/timeline": {
      "entry": ["test/*.unit.ts"]
    }
  }
}
