{
  "name": "snowy-media",
  "private": true,
  "description": "Snowy: a browser media toolkit. Workspace root; the packages are in packages/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-pk/snowy-media.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "bun --filter \"*\" build",
    "test": "bun --filter \"*\" test",
    "settings": "bun scripts/settings.ts",
    "format": "oxfmt && clang-format -i packages/ffmpeg/src/*.c packages/ffmpeg/src/*.h",
    "format:check": "oxfmt --check && clang-format --dry-run --Werror packages/ffmpeg/src/*.c packages/ffmpeg/src/*.h",
    "lint": "oxlint --type-aware --max-warnings 0 --report-unused-disable-directives-severity error",
    "lint:md": "markdownlint-cli2",
    "lint:rules": "bun tooling/check-lint-rules.ts",
    "lint:duplication": "bun tooling/check-duplication.ts",
    "lint:structure": "bun tooling/check-structure.ts",
    "lint:exceptions": "bun tooling/check-exceptions.ts",
    "lint:licences": "bun tooling/check-licences.ts",
    "lint:unused": "knip",
    "typecheck": "tsc && bun --filter \"*\" typecheck",
    "check": "bun run format:check && bun run lint && bun run lint:rules && bun run lint:duplication && bun run lint:structure && bun run lint:exceptions && bun run lint:licences && bun run typecheck && bun run lint:md && bun run lint:unused"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/chai": "5.2.3",
    "@wasm-fmt/clang-format": "23.1.1",
    "chai": "6.3.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "markdownlint": "0.42.0",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
