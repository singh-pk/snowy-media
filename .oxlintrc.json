{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2024": true,
    "browser": true,
    "worker": true
  },
  "ignorePatterns": [
    "packages/*/dist/**",
    "packages/ffmpeg/bench/variants/**",
    "packages/ffmpeg/bench/media/**",
    "packages/*/test/fixtures/**",
    "packages/ffmpeg/bench/results/**",
    "tooling/oxlint-rules/fixtures/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "off",
    "import/no-unassigned-import": "off",
    "import/no-absolute-path": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "unicorn/require-post-message-target-origin": "off",
    "repo/blank-line-around-blocks": "error",
    "repo/no-access-modifiers": "error",
    "repo/no-await-assertion": "error",
    "repo/no-classes": "error",
    "repo/no-nested-await": "error",
    "repo/no-promise-chains": "error",
    "repo/no-set-interval": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/tooling/unit"],
            "message": "Only a test/**/*.unit.ts file imports tooling/unit, and it runs in Chromium (AGENTS.md rule 2)."
          }
        ]
      }
    ],
    "repo/disable-needs-reason": "error",
    "repo/factory-only": "error",
    "repo/no-forced-closures": "error",
    "repo/no-loose-let": "error",
    "repo/no-process-comments": "error",
    "max-depth": ["error", 4],
    "no-else-return": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-array-for-each": "error",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }]
  },
  "jsPlugins": [
    {
      "name": "repo",
      "specifier": "./tooling/oxlint-rules/index.js"
    }
  ],
  "overrides": [
    {
      "files": ["packages/*/src/**"],
      "rules": {
        "repo/no-timers": "error"
      }
    },
    {
      "files": ["packages/engine/src/**", "packages/sync/src/**"],
      "rules": {
        "repo/copy-needs-reason": "error"
      }
    },
    {
      "files": ["packages/ffmpeg/src/io.js"],
      "globals": {
        "addToLibrary": "readonly",
        "Module": "readonly"
      }
    },
    {
      "files": ["packages/*/test/**/*.unit.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "message": "A unit test runs in Chromium: import test and expect from tooling/unit (AGENTS.md rule 2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/test/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/**", "**/tooling/unit"],
                "allowTypeImports": true,
                "message": "A *.test.ts file runs in Bun and only drives Chromium: test code goes in a *.unit.ts file or the page (AGENTS.md rule 2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/test/**"],
      "rules": {
        "repo/no-focused-tests": "error",
        "repo/test-has-assertion": "error",
        "repo/no-conditional-expect": "error"
      }
    },
    {
      "files": ["packages/sync/src/relay-auth.ts"],
      "rules": {
        "repo/no-loose-let": "off"
      }
    }
  ]
}
